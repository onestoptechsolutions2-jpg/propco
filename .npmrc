enable-pre-post-scripts=true
# pnpm 10+ sandboxes dependency build/postinstall scripts by default and
# refuses them non-interactively (ERR_PNPM_IGNORED_BUILDS) unless approved.
# `onlyBuiltDependencies` in pnpm-workspace.yaml lists which ones we trust;
# this flag is the belt-and-suspenders version so a Docker build (which
# can't run `pnpm approve-builds` interactively) doesn't get blocked by a
# dependency the workspace list didn't happen to name (e.g. a transitive
# native module pulled in by a version bump).
dangerously-allow-all-builds=true
