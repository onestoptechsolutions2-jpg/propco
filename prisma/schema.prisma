// PropCo — Phase 1 schema
// Covers: auth (NextAuth), roles, Owner, Property, Unit, Tenant, Lease.
// Later phases (Payment, Payout, Supplier, Invoice, Payroll, Document, Report)
// slot in as additional models without touching these.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth / Auth.js) ----------

enum Role {
  ADMIN
  STAFF
  OWNER
  LANDLORD // self-managing landlord: staff-level access, scoped to own properties
}

model User {
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set for credentials-based accounts; null for OAuth-only users
  role          Role      @default(STAFF)

  // IAM: custom role (permissions), suspension, password policy, brute-force lockout.
  orgRole            OrgRole?  @relation(fields: [orgRoleId], references: [id], onDelete: SetNull)
  orgRoleId          String?
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?

  // If this user is an Owner or Landlord, link them to their Owner record.
  ownerProfile Owner? @relation(fields: [ownerId], references: [id])
  ownerId      String? @unique

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain ----------

enum ManagementMode {
  AGENCY_MANAGED
  SELF_MANAGED
}

enum PropertyType {
  SINGLE_UNIT
  BUILDING
}

enum PropertyStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Owner {
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  payoutMethod  String? // "mpesa" | "bank" | "card" — free text for now, structured later
  bankDetails   String? // JSON-ish free text for v1; formalize in a later phase
  mpesaNumber   String?
  isSelfManaging Boolean @default(false)

  @@unique([orgId, email])
  @@index([orgId])

  user       User?
  properties Property[]
  payouts    Payout[]
  notifyChannel NotifyChannel @default(EMAIL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])
  id              String         @id @default(cuid())
  name            String
  addressLine1    String
  addressLine2    String?
  city            String?
  type            PropertyType   @default(SINGLE_UNIT)
  status          PropertyStatus @default(ACTIVE)
  managementMode  ManagementMode @default(AGENCY_MANAGED)
  platformFeeKes  Decimal?       @db.Decimal(10, 2) // used only when SELF_MANAGED
  commissionPct   Decimal        @default(10) @db.Decimal(5, 2) // agency's cut of collected rent, used only when AGENCY_MANAGED

  owner   Owner  @relation(fields: [ownerId], references: [id])
  ownerId String

  units     Unit[]
  schedules MaintenanceSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

model Unit {
  id           String     @id @default(cuid())
  label        String // e.g. "Unit 3B", or "Main House" for a single-unit property
  bedrooms     Int?
  bathrooms    Int?
  rentAmount   Decimal    @db.Decimal(10, 2)
  status       UnitStatus @default(VACANT)

  // Public vacancy page (/v/<id>) and short-stay (homestay / BnB) settings.
  listed       Boolean  @default(false)
  listingText  String?
  amenities    String? // comma separated: "WiFi, Parking, Balcony"
  photoUrls    String? // one link per line
  stayType     StayType @default(LONG_TERM)
  nightlyRate  Decimal? @db.Decimal(10, 2)

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  leases Lease[]
  maintenanceRequests MaintenanceRequest[]
  meters              UtilityMeter[]
  photos              Photo[]
  accessCodes         AccessCode[]
  bookings            Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model Tenant {
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  idNumber       String?
  emergencyName  String?
  emergencyPhone String?

  leases Lease[]
  notifyChannel NotifyChannel @default(EMAIL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}

model Lease {
  id          String      @id @default(cuid())
  startDate   DateTime
  endDate     DateTime?
  rentAmount  Decimal     @db.Decimal(10, 2)
  depositAmount Decimal?  @db.Decimal(10, 2)
  status      LeaseStatus @default(ACTIVE)

  // Move-out settlement (set when the unit is cleared).
  depositDeductions Decimal?  @db.Decimal(12, 2)
  depositRefund     Decimal?  @db.Decimal(12, 2) // negative = tenant still owes
  depositSettledAt  DateTime?
  depositMethod     String?
  depositRef        String?
  settlementNotes   String?

  unit     Unit   @relation(fields: [unitId], references: [id])
  unitId   String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  payments   Payment[]
  readings   MeterReading[]
  checklists Checklist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([tenantId])
}

// ---------- Rent collection (Phase 2) ----------

enum PaymentMethod {
  MPESA
  BANK
  CASH
  CARD
}

enum PaymentStatus {
  PENDING // expected but not yet received
  PAID
  LATE // past due date, still unpaid
  FAILED // e.g. a failed M-Pesa STK push attempt
}

model Payment {
  id       String        @id @default(cuid())
  amount   Decimal       @db.Decimal(10, 2)
  dueDate  DateTime
  paidDate DateTime?
  method   PaymentMethod @default(MPESA)
  status   PaymentStatus @default(PENDING)

  // M-Pesa/bank reference number, once wired up to the real Daraja API
  // (STK Push) in a later pass — see README "What's next".
  reference String?
  notes     String?

  lease   Lease  @relation(fields: [leaseId], references: [id])
  leaseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseId])
  @@index([dueDate])
}

// ---------- Owner payouts (Phase 3) ----------

enum PayoutStatus {
  PENDING
  PAID
}

// One row per owner per calendar month. Generated from that month's PAID
// rent on the owner's AGENCY_MANAGED properties, less the agency's
// per-property commission. Regenerating while still PENDING recalculates
// it; once PAID it is left alone.
model Payout {
  id          String       @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  grossRent   Decimal      @db.Decimal(12, 2)
  commission  Decimal      @db.Decimal(12, 2)
  maintenance Decimal      @default(0) @db.Decimal(12, 2) // DONE maintenance actualCost charged to the owner
  netAmount   Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(PENDING)
  method      String? // "MPESA" | "BANK" — how it was actually paid out
  reference   String? // M-Pesa code / bank ref for the payout itself
  paidDate    DateTime?

  owner   Owner  @relation(fields: [ownerId], references: [id])
  ownerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, periodStart])
  @@index([ownerId])
}

// ---------- Maintenance & suppliers (Phase 4) ----------

enum SupplierTrade {
  PLUMBER
  ELECTRICIAN
  CARPENTER
  PAINTER
  GENERAL
  OTHER
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model Supplier {
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])
  id      String        @id @default(cuid())
  name    String
  trade   SupplierTrade @default(GENERAL)
  phone   String?
  email   String?
  rate    Decimal?      @db.Decimal(10, 2) // informational call-out/hourly rate
  payoutMethod String?
  mpesaNumber  String?

  requests  MaintenanceRequest[]
  schedules MaintenanceSchedule[]
  invoices  SupplierInvoice[]
  notifyChannel NotifyChannel @default(EMAIL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A request and its work order are the same row here: supplierId null
// means "open, unassigned"; setting it is the assignment; status/actualCost
// track it through to completion. Kept as one model rather than splitting
// MaintenanceRequest/WorkOrder (per the original spec) to fit this phase's
// scope — splitting them later, if a request ever needs multiple suppliers
// or re-assignment history, is a straightforward follow-up.
model MaintenanceRequest {
  id           String            @id @default(cuid())
  description  String
  status       MaintenanceStatus @default(OPEN)
  reportedBy   String? // free text for now: tenant name, "staff", etc.
  costEstimate Decimal?          @db.Decimal(10, 2)
  actualCost   Decimal?          @db.Decimal(10, 2)
  completedAt  DateTime?

  // Supplier payment: set once the agency has paid the supplier for a DONE job.
  supplierPaidAt     DateTime?
  supplierPayMethod  String? // "MPESA" | "BANK"
  supplierPayRef     String?

  photos   Photo[]
  invoices SupplierInvoice[]

  unit   Unit   @relation(fields: [unitId], references: [id])
  unitId String

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([supplierId])
}

// ---------- Notifications (Phase 5) ----------

enum NotifyChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED // no provider configured, or recipient has no contact for the channel
}

// Outbox: every notification is a row; a dispatcher delivers QUEUED rows via
// whichever provider is configured (see src/lib/notify.ts). dedupeKey makes
// scheduled events (e.g. "rent late for payment X") idempotent.
model Notification {
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])
  id            String             @id @default(cuid())
  event         String // e.g. "RENT_LATE", "PAYOUT_SENT"
  channel       NotifyChannel
  recipientName String
  recipient     String? // email address or phone number
  subject       String
  body          String
  status        NotificationStatus @default(QUEUED)
  error         String?
  dedupeKey     String?            @unique
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([status])
  @@index([createdAt])
}

// ---------- Multi-tenancy & billing (SaaS) ----------

enum Plan {
  FREE // up to 5 units, forever
  GROWTH
  PRO
  SCALE
}

// One row per customer company (agency or landlord). Every business record
// belongs to exactly one. During the trial (trialEndsAt) limits are lifted;
// after it, unit limits follow `plan` until `paidUntil` (set when a payment
// is confirmed) - see src/lib/plans.ts.
model Organization {
  id          String    @id @default(cuid())
  name        String
  plan        Plan      @default(FREE)
  trialEndsAt DateTime
  paidUntil   DateTime?
  billingNote String?
  // Shown on tenant invoices: till/paybill, account name, bank details.
  payInstructions String?
  // WhatsApp number that vacancy-page enquiries and guest messages go to.
  contactPhone    String?
  // Supplier invoices above this amount (KES) need an ADMIN to approve; empty = no limit.
  approvalLimit   Decimal?  @db.Decimal(12, 2)

  users         User[]
  owners        Owner[]
  properties    Property[]
  tenants       Tenant[]
  suppliers     Supplier[]
  notifications Notification[]
  proofs        PaymentProof[]
  serviceLeads  ServiceLead[]
  invoices      SupplierInvoice[]
  roles         OrgRole[]
  employees     Employee[]
  payrollRuns   PayrollRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Utilities, move-in and move-out ----------

enum UtilityType {
  WATER
  ELECTRICITY
  INTERNET
  GAS
  OTHER
}

enum BillingMode {
  METERED // charge = (reading - previous reading) x rate
  FIXED // charge = rate, every billing period (e.g. flat internet fee)
}

enum BillStatus {
  UNPAID
  PAID
}

enum ChecklistType {
  MOVE_IN
  MOVE_OUT
}

// A meter (or flat-fee service) attached to a unit.
model UtilityMeter {
  id       String      @id @default(cuid())
  type     UtilityType
  label    String? // meter number / account, e.g. "KPLC 0123456"
  mode     BillingMode @default(METERED)
  rate     Decimal     @db.Decimal(10, 2) // KES per unit consumed, or the fixed monthly fee
  unitName String      @default("units") // m3, kWh, ...
  active   Boolean     @default(true)

  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId String

  readings MeterReading[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
}

// One reading = one bill, charged to whoever holds the lease at the time.
model MeterReading {
  id              String     @id @default(cuid())
  readingDate     DateTime
  reading         Decimal    @db.Decimal(12, 2)
  previousReading Decimal    @default(0) @db.Decimal(12, 2)
  consumption     Decimal    @default(0) @db.Decimal(12, 2)
  amount          Decimal    @db.Decimal(12, 2)
  status          BillStatus @default(UNPAID)
  paidDate        DateTime?
  notes           String?
  alert           String? // unusual-usage flag, e.g. "2.4x higher than usual"

  meter   UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  meterId String

  lease   Lease?  @relation(fields: [leaseId], references: [id])
  leaseId String?

  createdAt DateTime @default(now())

  @@index([meterId])
  @@index([leaseId])
}

// Move-in / move-out checklist for a lease (one of each).
model Checklist {
  id          String        @id @default(cuid())
  type        ChecklistType
  completedAt DateTime?
  notes       String?

  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId String

  items ChecklistItem[]

  createdAt DateTime @default(now())

  @@unique([leaseId, type])
}

model ChecklistItem {
  id        String  @id @default(cuid())
  category  String // "TASK" | "INVENTORY"
  label     String
  done      Boolean @default(false)
  condition String? // GOOD | FAIR | DAMAGED (inventory items)
  notes     String?
  cost      Decimal @default(0) @db.Decimal(10, 2) // damage/cleaning charge deducted from the deposit
  sortOrder Int     @default(0)

  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistId String

  @@index([checklistId])
}

// ---------- Manual M-Pesa: proof of payment ----------

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

// A tenant pays the agency's till/paybill by M-Pesa and forwards the
// confirmation SMS. Staff paste it in; it is read automatically, matched to a
// tenant, and becomes a rent payment only when staff approve it.
model PaymentProof {
  id         String      @id @default(cuid())
  rawMessage String      @db.Text
  code       String? // M-Pesa transaction code, unique per company (blocks reuse)
  amount     Decimal?    @db.Decimal(12, 2)
  payerName  String?
  payerPhone String?
  status     ProofStatus @default(PENDING)
  reviewNote String?
  leaseId    String?
  paymentId  String?

  org   Organization @relation(fields: [orgId], references: [id])
  orgId String

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@unique([orgId, code])
  @@index([orgId, status])
}

// ---------- Preventive maintenance calendar ----------

// A recurring job on a property (tank cleaning, fire extinguishers, generator
// service...). "Mark done" rolls nextDue forward by intervalMonths.
model MaintenanceSchedule {
  id             String    @id @default(cuid())
  title          String
  intervalMonths Int
  nextDue        DateTime
  lastDone       DateTime?
  estimatedCost  Decimal?  @db.Decimal(10, 2)
  notes          String?
  active         Boolean   @default(true)

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([nextDue])
}

// ---------- Smart-lock access codes and short-stay bookings ----------

enum StayType {
  LONG_TERM
  SHORT_STAY
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

// A door/keypad code for a unit (tenant, caretaker, cleaner or guest). PropCo
// tracks and shares the code and revokes it at move-out / check-out; the code
// itself is programmed on the lock (or a lock provider) by a person for now.
model AccessCode {
  id        String    @id @default(cuid())
  label     String // "Tenant", "Caretaker", "Cleaner", "Guest: Jane"
  code      String
  validFrom DateTime  @default(now())
  validTo   DateTime?
  active    Boolean   @default(true)
  bookingId String?

  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId String

  createdAt DateTime @default(now())

  @@index([unitId])
  @@index([bookingId])
}

model Booking {
  id          String        @id @default(cuid())
  guestName   String
  guestPhone  String?
  guestEmail  String?
  guests      Int           @default(1)
  checkIn     DateTime
  checkOut    DateTime
  nightlyRate Decimal       @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(12, 2)
  paid        Decimal       @default(0) @db.Decimal(12, 2)
  status      BookingStatus @default(CONFIRMED)
  source      String        @default("Direct") // Airbnb, Booking.com, Direct...
  notes       String?
  cleaned     Boolean       @default(true)

  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId String

  createdAt DateTime @default(now())

  @@index([unitId, checkIn])
}

// ---------- Services and insurance marketplace ----------

enum ServiceCategory {
  INSURANCE
  CLEANING
  MOVERS
  INTERNET
  SECURITY
  SOLAR
  LEGAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  WON
  LOST
}

// A vetted provider the platform recommends to every company. Managed by
// platform admins; commissionNote records the referral deal (not shown to customers).
model ServicePartner {
  id             String          @id @default(cuid())
  name           String
  category       ServiceCategory
  description    String?
  phone          String // WhatsApp number quotes are requested on
  commissionNote String?
  active         Boolean         @default(true)

  leads ServiceLead[]

  createdAt DateTime @default(now())
}

// A customer asked a partner for a quote through PropCo: the referral to track.
model ServiceLead {
  id            String     @id @default(cuid())
  note          String?
  status        LeadStatus @default(NEW)
  commissionKes Decimal?   @db.Decimal(10, 2) // what PropCo earned once WON

  partner   ServicePartner @relation(fields: [partnerId], references: [id])
  partnerId String
  org       Organization   @relation(fields: [orgId], references: [id])
  orgId     String

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([partnerId])
}

// ---------- Photos (stored in the database, resized on the phone before upload) ----------

// Attached to a repair request (evidence / progress) or to a unit (vacancy page).
model Photo {
  id      String @id @default(cuid())
  orgId   String
  mime    String
  data    Bytes
  caption String?

  request   MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String?
  unit      Unit?               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    String?

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([unitId])
}

// ---------- Supplier invoices ----------

enum InvoiceStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

// A supplier's bill (entered by staff from what the supplier sent). Flow:
// SUBMITTED -> APPROVED (ADMIN above the company's approval limit) -> PAID.
// Approving an invoice linked to a repair sets that repair's actual cost, so the
// owner is charged in their payout.
model SupplierInvoice {
  id          String        @id @default(cuid())
  number      String? // the supplier's own invoice number
  description String
  amount      Decimal       @db.Decimal(12, 2) // before VAT
  vat         Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  status      InvoiceStatus @default(SUBMITTED)
  reviewNote  String?
  approvedAt  DateTime?
  paidAt      DateTime?
  payMethod   String?
  payRef      String?

  org   Organization @relation(fields: [orgId], references: [id])
  orgId String

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  request   MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId String?

  createdAt DateTime @default(now())

  @@index([orgId, status])
  @@index([supplierId])
}

// ---------- Payroll ----------

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model Employee {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  email       String?
  idNumber    String?
  kraPin      String?
  nssfNo      String?
  shifNo      String?
  jobTitle    String?
  basicSalary Decimal   @db.Decimal(12, 2)
  allowances  Decimal   @default(0) @db.Decimal(12, 2) // taxable monthly allowances (housing, transport...)
  payMethod   String    @default("MPESA")
  mpesaNumber String?
  bankDetails String?
  startDate   DateTime?
  active      Boolean   @default(true)
  notifyChannel NotifyChannel @default(WHATSAPP)

  org   Organization @relation(fields: [orgId], references: [id])
  orgId String

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model PayrollRun {
  id         String        @id @default(cuid())
  period     DateTime // first day of the month (UTC)
  status     PayrollStatus @default(DRAFT)
  approvedAt DateTime?

  org   Organization @relation(fields: [orgId], references: [id])
  orgId String

  payslips Payslip[]

  createdAt DateTime @default(now())

  @@unique([orgId, period])
}

model Payslip {
  id                  String   @id @default(cuid())
  basic               Decimal  @db.Decimal(12, 2)
  allowances          Decimal  @db.Decimal(12, 2)
  extraEarnings       Decimal  @default(0) @db.Decimal(12, 2) // bonus, commission, overtime
  gross               Decimal  @db.Decimal(12, 2)
  nssf                Decimal  @db.Decimal(12, 2)
  shif                Decimal  @db.Decimal(12, 2)
  housingLevy         Decimal  @db.Decimal(12, 2)
  taxablePay          Decimal  @db.Decimal(12, 2)
  paye                Decimal  @db.Decimal(12, 2)
  otherDeductions     Decimal  @default(0) @db.Decimal(12, 2) // loans, advances
  netPay              Decimal  @db.Decimal(12, 2)
  employerNssf        Decimal  @db.Decimal(12, 2)
  employerHousingLevy Decimal  @db.Decimal(12, 2)
  paidAt              DateTime?
  payMethod           String?
  payRef              String?
  notes               String?

  run   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  @@unique([runId, employeeId])
}

// ---------- IAM: custom roles and audit trail ----------

// A named set of permissions an admin builds for their own company (e.g.
// "Accountant", "Caretaker"). Users with a custom role are org-wide staff whose
// access is limited to exactly these permissions (see src/lib/permissions.ts).
model OrgRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  permissions String[]

  org   Organization @relation(fields: [orgId], references: [id])
  orgId String

  users User[]

  createdAt DateTime @default(now())

  @@unique([orgId, name])
}

// Who did what, when. Written for people, role and money changes.
model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String?
  actorName String
  action    String // e.g. "user.created", "role.updated", "payroll.approved"
  detail    String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}
