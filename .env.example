# Copy to .env and fill in. Full explanations: docs/deployment.md and docs/payments.md

# ---- Core ----
DATABASE_URL=postgresql://propco:propco@localhost:5432/propco?schema=public
# Optional with Docker (generated and persisted on first boot). Generate with: openssl rand -base64 32
AUTH_SECRET=
# The public address of this deployment (used for sign-in and payment webhook URLs)
APP_URL=http://localhost:3010
# Comma-separated emails allowed to open the SaaS admin (Client companies)
PLATFORM_ADMIN_EMAILS=

# ---- Sign-in with Google (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Messages (optional; without them messages are logged as SKIPPED) ----
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- Online payments ----
# Key for encrypting companies' saved provider secrets. Set once, keep it safe: changing it
# makes saved secrets unreadable. Falls back to AUTH_SECRET if empty.
PAYMENTS_ENCRYPTION_KEY=

# PropCo's OWN merchant account, for companies paying for their plan online. All optional:
# leave empty and Billing keeps the manual "pay the till, share the proof" flow.
PLATFORM_CALLBACK_TOKEN=            # long random string, part of the webhook URL (openssl rand -hex 24)
PLATFORM_MPESA_ENV=sandbox          # sandbox | production
PLATFORM_MPESA_KIND=PAYBILL         # PAYBILL | TILL
PLATFORM_MPESA_SHORTCODE=
PLATFORM_MPESA_PARTY_B=             # the till number, for TILL
PLATFORM_MPESA_CONSUMER_KEY=
PLATFORM_MPESA_CONSUMER_SECRET=
PLATFORM_MPESA_PASSKEY=
PLATFORM_FLW_SECRET_KEY=
PLATFORM_FLW_WEBHOOK_HASH=

# Manual billing details shown on the Billing page
BILLING_MPESA_TILL=
BILLING_WHATSAPP=

# Tests only. Never set these in production.
# MPESA_BASE_URL=http://localhost:4010
# FLUTTERWAVE_BASE_URL=http://localhost:4010
